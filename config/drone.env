# Local defaults. Exported variables and drone-nav command options take precedence.
# USB-connected FCU; change to e.g. /dev/ttyTHS1:921600 for a telemetry UART.
DRONE_FCU_URL="${DRONE_FCU_URL:-/dev/ttyACM0:57600}"
DRONE_GCS_URL="${DRONE_GCS_URL:-}"
DRONE_TARGET_SYSTEM="${DRONE_TARGET_SYSTEM:-1}"
DRONE_TARGET_COMPONENT="${DRONE_TARGET_COMPONENT:-1}"
DRONE_CAMERA_SERIAL="${DRONE_CAMERA_SERIAL:-}"
DRONE_CAMERA_USB_PORT="${DRONE_CAMERA_USB_PORT:-}"
DRONE_STARTUP_TIMEOUT="${DRONE_STARTUP_TIMEOUT:-120}"
DRONE_IMU_RATE="${DRONE_IMU_RATE:-200}"
DRONE_ROS_PYTHON="${DRONE_ROS_PYTHON:-/usr/bin/python2}"
